// ===============================
// ADMIN LOGIN
// ===============================

app.post('/api/admin/login', (req, res) => {
  try {
    const { username, password } = req.body;

    if (!username || !password) {
      return res.status(400).json({
        message: 'Username and password are required'
      });
    }

    if (!fs.existsSync(adminFile)) {
      console.error('ADMIN FILE NOT FOUND:', adminFile);

      return res.status(500).json({
        message: 'Admin configuration file was not found'
      });
    }

    const admin = JSON.parse(
      fs.readFileSync(adminFile, 'utf8')
    );

    if (username !== admin.username) {
      return res.status(401).json({
        message: 'Invalid username or password'
      });
    }

    const passwordMatch = bcrypt.compareSync(
      password,
      admin.password
    );

    if (!passwordMatch) {
      return res.status(401).json({
        message: 'Invalid username or password'
      });
    }

    const token = jwt.sign(
      {
        username: admin.username,
        role: 'admin'
      },
      JWT_SECRET,
      {
        expiresIn: '8h'
      }
    );

    res.json({
      message: 'Login successful',
      token: token,

      admin: {
        username: admin.username,
        role: 'admin'
      }
    });
  } catch (error) {
    console.error('ADMIN LOGIN ERROR:', error);

    res.status(500).json({
      message: 'Admin login failed. Check the backend terminal.'
    });
  }
});

 // ===============================
 // PAYSTACK: INITIALIZE PAYMENT
 // PUBLIC - AMOUNT COMES FROM SAVED ORDER
 // ===============================

app.post('/api/payments/paystack/initialize', async (req, res) => {
  try {
    if (!PAYSTACK_SECRET_KEY) {
      return res.status(503).json({
        message: 'Online payments are not configured yet.'
      });
    }

    const orderId = Number(req.body.orderId);

    if (!Number.isSafeInteger(orderId) || orderId <= 0) {
      return res.status(400).json({
        message: 'A valid order ID is required.'
      });
    }

    const orders = getOrders();
    const order = orders.find(item => Number(item.id) === orderId);

    if (!order) {
      return res.status(404).json({
        message: 'Order not found.'
      });
    }

    if (order.paymentMethod !== 'Paystack') {
      return res.status(400).json({
        message: 'This order was not created for Paystack payment.'
      });
    }

    if (order.paymentStatus === 'paid') {
      return res.status(409).json({
        message: 'This order has already been paid.'
      });
    }

    const email = String(order.customer?.email || '').trim();

    if (!email) {
      return res.status(400).json({
        message: 'A valid customer email is required for online payment.'
      });
    }

    // Charge the saved merchandise subtotal only.
    // Delivery is excluded until the shop confirms its fee.
    const amountInPesewas = Math.round(Number(order.subtotal) * 100);

    if (!Number.isSafeInteger(amountInPesewas) || amountInPesewas <= 0) {
      return res.status(400).json({
        message: 'The order subtotal is invalid for online payment.'
      });
    }

    const paystackResponse = await fetch(
      'https://api.paystack.co/transaction/initialize',
      {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${PAYSTACK_SECRET_KEY}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          email,
          amount: String(amountInPesewas),
          currency: 'GHS',
          callback_url: PAYSTACK_CALLBACK_URL,
          metadata: {
            orderId: order.id,
            customerName:
              `${order.customer?.firstName || ''} ${order.customer?.lastName || ''}`.trim()
          }
        })
      }
    );

    const result = await paystackResponse.json();

    if (!paystackResponse.ok || !result.status || !result.data?.authorization_url) {
      console.error('PAYSTACK INITIALIZE ERROR:', result);

      return res.status(502).json({
        message: result.message || 'Could not initialize Paystack payment.'
      });
    }

    // Save the reference returned by Paystack.
    order.paymentReference = result.data.reference;
    order.paymentStatus = 'pending';
    order.paymentMethod = 'Paystack';
    order.paystackAmount = amountInPesewas;
    saveOrders(orders);

    return res.json({
      message: 'Payment initialized successfully.',
      authorizationUrl: result.data.authorization_url,
      reference: result.data.reference
    });
  } catch (error) {
    console.error('PAYSTACK INITIALIZE ERROR:', error);

    return res.status(500).json({
      message: 'Could not start online payment.'
    });
  }
});

// ===============================
// PAYSTACK: VERIFY PAYMENT
// PUBLIC CALLBACK, VERIFIED SERVER-SIDE
// ===============================

app.get('/api/payments/paystack/verify/:reference', async (req, res) => {
  try {
    if (!PAYSTACK_SECRET_KEY) {
      return res.status(503).json({
        message: 'Online payments are not configured yet.'
      });
    }

    const reference = String(req.params.reference || '').trim();

    if (!reference || reference.length > 200) {
      return res.status(400).json({
        message: 'A valid payment reference is required.'
      });
    }

    const orders = getOrders();

    const order = orders.find(
      item => item.paymentReference === reference
    );

    if (!order) {
      return res.status(404).json({
        message: 'No order was found for this payment reference.'
      });
    }

    // Never downgrade an order that has already been verified as paid.
    if (order.paymentStatus === 'paid') {
      return res.json({
        verified: true,
        paymentStatus: 'paid',
        orderId: order.id
      });
    }

    const paystackResponse = await fetch(
      `https://api.paystack.co/transaction/verify/${encodeURIComponent(reference)}`,
      {
        method: 'GET',
        headers: {
          Authorization: `Bearer ${PAYSTACK_SECRET_KEY}`
        }
      }
    );

    const result = await paystackResponse.json();

    if (!paystackResponse.ok || !result.status || !result.data) {
      console.error('PAYSTACK VERIFY ERROR:', result);

      return res.status(502).json({
        message: 'Could not verify the payment with Paystack.'
      });
    }

    const transaction = result.data;
    const expectedAmount = Number(order.paystackAmount);

    const amountMatches =
      Number.isSafeInteger(expectedAmount) &&
      Number(transaction.amount) === expectedAmount;

    const currencyMatches = transaction.currency === 'GHS';
    const referenceMatches = transaction.reference === reference;
    const successful = transaction.status === 'success';

    if (
      !successful ||
      !amountMatches ||
      !currencyMatches ||
      !referenceMatches
    ) {
      order.paymentStatus = successful
        ? 'verification_failed'
        : 'unpaid';

      saveOrders(orders);

      return res.status(400).json({
        verified: false,
        paymentStatus: order.paymentStatus,
        message: 'Payment could not be confirmed for the expected amount and currency.'
      });
    }

    order.paymentStatus = 'paid';
    order.paymentMethod = 'Paystack';
    order.paidAt = new Date().toISOString();

    saveOrders(orders);

    return res.json({
      verified: true,
      paymentStatus: 'paid',
      orderId: order.id
    });
  } catch (error) {
    console.error('PAYSTACK VERIFY ERROR:', error);

    return res.status(500).json({
      message: 'Could not verify the payment.'
    });
  }
});

