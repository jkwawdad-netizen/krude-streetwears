// ===============================
// CREATE ORDER
// PUBLIC
// SAVES WHATSAPP CONSENT
// ===============================

app.post('/api/orders', (req, res) => {
  try {
    const orders = getOrders();

    const newId = orders.length > 0
      ? Math.max(
          ...orders.map(order => Number(order.id) || 0)
        ) + 1
      : 1;

    // Only an explicit true value counts as consent.
    const whatsappOptIn =
      req.body.whatsappOptIn === true ||
      req.body.customer?.whatsappOptIn === true;

    const newOrder = {
      id: newId,

      customer: {
        firstName: req.body.customer?.firstName || '',
        lastName: req.body.customer?.lastName || '',
        phone: req.body.customer?.phone || '',
        email: req.body.customer?.email || '',
        address: req.body.customer?.address || '',
        city: req.body.customer?.city || '',
        region: req.body.customer?.region || '',
        whatsappOptIn: whatsappOptIn
      },

      // The admin dashboard also checks this top-level field.
      whatsappOptIn: whatsappOptIn,

      items: Array.isArray(req.body.items)
        ? req.body.items
        : [],

      subtotal: Number(req.body.subtotal) || 0,
      deliveryFee: Number(req.body.deliveryFee) || 0,
      total: Number(req.body.total) || 0,

      paymentMethod:
        req.body.paymentMethod ||
        'Payment on confirmation',

      deliveryMethod:
        req.body.deliveryMethod ||
        'Standard Delivery',

      status: 'Pending',
      createdAt: new Date().toISOString()
    };

    orders.push(newOrder);
    saveOrders(orders);

    res.status(201).json({
      message: 'Order created successfully',
      order: newOrder
    });
  } catch (error) {
    console.error('CREATE ORDER ERROR:', error);

    res.status(500).json({
      message: 'Could not create order'
    });
  }
});

